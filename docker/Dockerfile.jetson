# EdgeVision deployment container — TensorRT inference on Jetson Nano.
#
# MUST be built on the Jetson. This is an arm64 image, and PyCUDA compiles
# against the CUDA headers present on the device.
#
# TensorRT is not installed separately by this Dockerfile. On Jetson, the
# NVIDIA container runtime exposes the compatible host JetPack/TensorRT stack
# needed by the container. Verified on this Nano: TensorRT 8.2.1.8.
#
# Deliberately excludes torch. A container with torch would be several GB and
# slow to build on a 2 GB board, and the deployment path does not need it --
# TorchScript is the baseline for comparison, not the thing being shipped.
#
#   docker build -f docker/Dockerfile.jetson -t edgevision:latest .
#   docker run --rm \
#       -v $(pwd)/models:/app/models \
#       -v $(pwd)/data:/app/data \
#       -v $(pwd)/results:/app/results \
#       edgevision:latest --runtime tensorrt --precision fp16 --frames 500

FROM nvcr.io/nvidia/l4t-base:r32.7.1

# Fail the build rather than hang on an interactive prompt.
ENV DEBIAN_FRONTEND=noninteractive

# Without a locale, Python 3.6 defaults to ASCII for file I/O and fails on any
# non-ASCII character -- an em dash in a YAML comment is enough. The host has a
# UTF-8 locale; the container does not inherit one.
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# CUDA is in the base image but not on PATH by default. PyCUDA's build needs
# nvcc; the runtime needs the shared libraries.
ENV PATH=/usr/local/cuda/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# python3-dev provides Python.h for PyCUDA's C extension.
# python3-opencv is the distribution OpenCV build, not the JetPack host build.
# That difference matters for performance, but this pipeline only needs the CPU
# resize / video I/O path used by the current deployment.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
        python3-dev \
        python3-numpy \
        python3-yaml \
        python3-opencv \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu ships pip 9.0.1, which predates --no-build-isolation (added in pip 10).
# Capped below 21.0, which drops Python 3.6 support entirely.
RUN pip3 install --no-cache-dir --upgrade "pip<21.0" setuptools wheel

# --no-build-isolation is required: PyCUDA declares numpy==1.12.1 as a build
# dependency, and pip would create an isolated environment and try to compile
# that 2017 release, which includes <xlocale.h> -- removed from glibc years ago.
# `six` is imported by pycuda.driver at runtime but not declared as a dependency.
# The host had it from another package; the container does not.
RUN pip3 install --no-cache-dir --no-build-isolation "pycuda==2020.1" six

WORKDIR /app

# Only app/ is copied. benchmarks/ and evaluation/ are tools run against the
# deployment, not part of it -- which is why the repository separates them.
COPY app/ /app/app/
COPY configs/ /app/configs/

# Mounted at run time rather than baked in: TensorRT engines are treated as
# target-specific deployment artifacts, while videos/results are external data.
VOLUME ["/app/models", "/app/data", "/app/results"]

# Unbuffered, so container logs appear immediately rather than on flush.
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Lightweight environment check only. This verifies that TensorRT imports and
# that CUDA exposes at least one device; it does not prove the engine loads or
# that the application is healthy. Part 8/9 can replace this with an app-level
# health endpoint once the inference service exists.
HEALTHCHECK --interval=30s --timeout=10s --retries=2 \
    CMD python3 -c "import tensorrt, pycuda.driver as cuda; cuda.init(); assert cuda.Device.count() > 0" || exit 1

ENTRYPOINT ["python3", "/app/app/run.py"]
CMD ["--runtime", "tensorrt", "--precision", "fp16"]
